# ==========================================
# Yuki — Environment Variables & API Keys
# ==========================================
#
# `tests/test_entorno_declarado.py` comprueba que este fichero no vaya por
# detrás del código: toda variable que alguien lee está aquí, y toda variable
# de aquí la lee alguien o dice que no.

# --- Núcleo de la arquitectura (hermes_config.yaml) ---
# Nous Portal es la pasarela de herramientas (gateway: nous_portal)
NOUS_PORTAL_API_KEY=your_nous_portal_token_here
# El endpoint de Nous Portal aún no existe. Modos:
#   disabled (por defecto) -> se salta y el tráfico sale por OpenRouter
#   mock                   -> respuestas simuladas, para desarrollo sin red
NOUS_PORTAL_MODE=disabled
# OpenRouter es el agregador de LLM (default_aggregator: openrouter).
# Los modelos concretos los declara `config.yaml` (agent.model y
# provider_routing.routes); aquí sólo va la clave.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Vertex AI: Gemini con cargo al crédito de Google Cloud ---
# Ojo al matiz, porque decide si el crédito se gasta o no:
#   · GEMINI_API_KEY (AI Studio)  -> EXCLUIDO del crédito de prueba desde
#                                    marzo de 2026. Se factura aparte.
#   · Vertex AI                   -> SÍ consume el crédito. Es esta ruta.
# Vertex no usa clave: se autentica con las credenciales del proyecto.
#   En local:      gcloud auth application-default login
#   En Cloud Run:  la cuenta de servicio yuki-runtime, con roles/aiplatform.user
# Basta con declarar el proyecto para que la cadena salga por aquí.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Proyecto de respaldo si no se declara VERTEX_PROJECT_ID (lo pone la propia VM).
GOOGLE_CLOUD_PROJECT=
# Solo si no usas ADC ni la identidad de Cloud Run:
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/clave-cuenta-servicio.json

# --- Model Armor (filtrado de entrada y salida en Vertex) ---
# Sin proyecto declarado hereda VERTEX_PROJECT_ID.
MODEL_ARMOR_PROJECT_ID=

# --- Acceso directo a proveedores (OPCIONAL) ---
# La arquitectura no lo requiere: OpenRouter ya da acceso a estos modelos.
# no se lee: `llm_proveedores` habla siempre por el agregador o por Vertex; se
# conservan porque documentan qué haría falta para saltárselo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Estas dos sí se leen, pero sólo para avisar: si están puestas, el gemelo
# virtual declara un limitador, porque AI Studio no consume el crédito.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Servicios especializados si se usan sueltos, sin la pasarela ---
FAL_KEY=your_fal_ai_key_if_standalone_here
FIRECRAWL_API_KEY=your_firecrawl_key_if_standalone_here

# Honcho Dialectic Modeling Key
# no se lee: el perfil dialéctico es local (`data/honcho_profile.json`).
# No hay cliente remoto; se conserva para el día que se contrate el servicio.
HONCHO_API_KEY=
# no se lee: no hay servicio remoto al que identificar una aplicación.
HONCHO_APP_ID=yuki-digital-diva

# --- Telegram: salida real; la entrada (polling) no está implementada ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Lista de acceso: servidores y canales donde Yuki responde. Vacío en canales
# significa «todos los del guild autorizado»; vacío en guilds, ninguno.
DISCORD_ALLOWED_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_ID=
# Quién puede hablarle por DM como Productor (IDs separados por coma). Sin
# declararla, ningún DM se trata como del Productor: no hay valor por defecto,
# y no lo hay a propósito.
DISCORD_PAIRED_PRODUCER_ID=
# Dónde vive el emparejamiento confirmado con `!pair`. Por defecto, junto a la
# base de datos.
DISCORD_PAIRING_PATH=

# --- Copia de memoria y canon fuera de la instancia (opcional) ---
# Bucket de Cloud Storage donde subir la copia diaria. Sin él, la copia se
# escribe en el disco de la instancia y el resultado avisa de que no sale de ahí.
BACKUP_GCS_BUCKET=

# --- Salón web ---
# Con token declarado, las rutas /api exigen `Authorization: Bearer` (o ?token=).
# Sin él quedan abiertas a quien alcance el puerto: puede gastar crédito y, peor,
# escribir en la memoria de Yuki. El arranque avisa cuando falta.
SALON_API_TOKEN=
# Puerto en el que escucha el Salón. Las plataformas gestionadas lo imponen.
PORT=8080

# --- Freno de mano ---
# Manda sobre el que el Productor ponga por DM, y no se puede soltar desde
# dentro: es la parada que un operador conserva. Valores: publicacion, medios,
# todo. Vacío = sin freno de entorno.
YUKI_FRENO=

# --- Reubicación del estado durable ---
# Cada pieza del inventario (`cli.py estado`) puede vivir fuera de `data/`.
# Están aquí porque la regla del proyecto exige que cada estado nuevo tenga la
# suya, y porque son lo que `tests/conftest.py` redirige para que la suite no
# escriba en la instancia.
DATABASE_PATH=data/yuki_memory.db
YUKI_OUTPUT_DIR=
YUKI_BLACKBOX_PATH=
YUKI_SPEND_LEDGER_PATH=
YUKI_AGENCY_LEDGER_PATH=
YUKI_RITUALS_PATH=
YUKI_TRANSPARENCY_PATH=
YUKI_CUADERNO_PATH=
YUKI_PERSONA_PATH=
YUKI_FRENO_PATH=
YUKI_RUNTIME_CONFIG_PATH=

# --- Respaldo musical local ---
# Banco de sonidos que usa FluidSynth cuando Lyria no está. La imagen trae uno.
YUKI_SOUNDFONT=

# --- Réplica y diagnóstico ---
# Marca la instancia como gemelo virtual: evita que se confunda con producción.
YUKI_VIRTUAL_INSTANCE=

# App Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
