# ==========================================
# Yuki — Environment Variables & API Keys
# ==========================================

# --- Núcleo de la arquitectura (hermes_config.yaml) ---
# Nous Portal es la pasarela de herramientas (gateway: nous_portal)
NOUS_PORTAL_API_KEY=your_nous_portal_token_here
# El endpoint de Nous Portal aún no existe. Modos:
#   disabled (por defecto) -> se salta y el tráfico sale por OpenRouter
#   mock                   -> respuestas simuladas, para desarrollo sin red
NOUS_PORTAL_MODE=disabled
# OpenRouter es el agregador de LLM (default_aggregator: openrouter).
# Los modelos se nombran a través de él: openrouter/anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Vertex AI: Gemini con cargo al crédito de Google Cloud ---
# Ojo al matiz, porque decide si el crédito se gasta o no:
#   · GEMINI_API_KEY (AI Studio)  -> EXCLUIDO del crédito de prueba desde
#                                    marzo de 2026. Se factura aparte.
#   · Vertex AI                   -> SÍ consume el crédito. Es esta ruta.
# Vertex no usa clave: se autentica con las credenciales del proyecto.
#   En local:      gcloud auth application-default login
#   En Cloud Run:  la cuenta de servicio yuki-runtime, con roles/aiplatform.user
# Basta con declarar el proyecto para que la cadena salga por aquí.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Solo si no usas ADC ni la identidad de Cloud Run:
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/clave-cuenta-servicio.json

# --- Acceso directo a proveedores (OPCIONAL) ---
# La arquitectura no lo requiere: OpenRouter ya da acceso a estos modelos.
# Rellénalas solo si quieres saltarte el agregador para algún caso concreto.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# No la uses para gastar el crédito de Google Cloud: usa VERTEX_PROJECT_ID.
GEMINI_API_KEY=

# --- Servicios especializados si se usan sueltos, sin la pasarela ---
FAL_KEY=your_fal_ai_key_if_standalone_here
FIRECRAWL_API_KEY=your_firecrawl_key_if_standalone_here

# Honcho Dialectic Modeling Key
HONCHO_API_KEY=your_honcho_api_key_here
HONCHO_APP_ID=yuki-digital-diva

# Social Platforms
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ANNOUNCE_CHANNEL_ID=your_discord_channel_id_here

# --- Copia de memoria y canon fuera de la instancia (opcional) ---
# Bucket de Cloud Storage donde subir la copia diaria. Sin él, la copia se
# escribe en el disco de la instancia y el resultado avisa de que no sale de ahí.
BACKUP_GCS_BUCKET=

# App Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_PATH=data/yuki_memory.db
