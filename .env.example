# ==========================================
# Yuki — Environment Variables & API Keys
# ==========================================

# --- PRINCIPAL: Nous Portal ---
# Agregador principal. Cubre modelos + Tool Gateway (FAL, OpenAI TTS/Whisper,
# Firecrawl, Browser Use, Modal). OAuth: `hermes setup --portal` genera el
# refresh token en ~/.hermes/auth.json; en producción llega por Secret Manager.
NOUS_PORTAL_API_KEY=your_nous_portal_token_here

# --- AUXILIAR: respaldo si el Portal falla o agota créditos ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- EMERGENCIA: claves directas, sólo si caen las dos anteriores ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Innecesarias con Nous Portal de pago (FAL y Firecrawl van incluidos en el
# Tool Gateway). Se retiran en el paso 2.9 del plan de infraestructura.
FAL_KEY=your_fal_ai_key_if_standalone_here
FIRECRAWL_API_KEY=your_firecrawl_key_if_standalone_here

# Honcho Dialectic Modeling Key
HONCHO_API_KEY=your_honcho_api_key_here
HONCHO_APP_ID=yuki-digital-diva

# Social Platforms
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ANNOUNCE_CHANNEL_ID=your_discord_channel_id_here

# App Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DATABASE_PATH=data/yuki_memory.db
