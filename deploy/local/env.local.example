# ==========================================================================
# Variables de Yuki en el MSI. Cópialo a `.env.local` en la raíz del repo y
# rellénalo TÚ, a mano: los secretos no pasan por ningún agente.
#
#   cp deploy/local/env.local.example .env.local && chmod 600 .env.local
#
# Aquí sólo hay variables que el código lee (`tests/test_despliegue_local.py`
# lo vigila). Lo que falta falta a propósito:
#   · VERTEX_PROJECT_ID / GOOGLE_*   el crédito caducó; declararlo en una
#                                    cuenta ya de pago factura cada imagen.
#   · BACKUP_GCS_BUCKET             la copia sale a YUKI_COPIAS_DIR del compose.
#   · NOUS_PORTAL_API_KEY / HONCHO  declaradas en .env.example y no leídas.
# ==========================================================================

# --- Imprescindibles: sin ellas el arranque muere a propósito ---
# Una clave SÓLO para Yuki, con límite de crédito puesto en OpenRouter.
# No la compartas con el agente de OpenClaw: él lleva la suya.
OPENROUTER_API_KEY=
# Mientras la VM de Google siga encendida, usa el token de un bot de pruebas:
# dos instancias con el mismo token contestan las dos a cada mensaje.
DISCORD_BOT_TOKEN=

# --- Quién puede hablar con ella (IDs numéricos de Discord, no nombres) ---
DISCORD_ALLOWED_GUILD_ID=
# Vacío = todos los canales de los servidores autorizados.
DISCORD_ALLOWED_CHANNEL_ID=
DISCORD_PAIRED_PRODUCER_ID=

# --- Muy recomendable aunque el Salón sólo escuche en 127.0.0.1 ---
# Sin él las rutas /api quedan abiertas a cualquier proceso de la máquina,
# incluido el agente de al lado. Genera uno con: openssl rand -hex 32
SALON_API_TOKEN=

# --- Opcionales ---
# Búsqueda web con URL verificable; sin ella, pistas marcadas `simulated`.
FIRECRAWL_API_KEY=
# Difusión (sólo salida).
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
LOG_LEVEL=INFO
